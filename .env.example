# constitutional-swarm — environment template
#
# Copy to `.env` and fill in only what your workflow needs:
#   cp .env.example .env
#
# NOTHING here is required for `make setup`, `make smoke`, `make lint`,
# `make agent-check`, or the default `make test` suite — those run fully
# offline with no credentials (CI injects dummy keys). Credentials are only
# needed for live LLM agent runs, eval logging, or on-chain deployment.
#
# Legend:  [required-for: <workflow>]  marks when a var becomes necessary.

# --- LLM providers (live agent runs only) ---------------------------------
# Anthropic Claude — the default backend for SWE-bench / governed-handoff
# agents.  [required-for: live SWE-bench runs, governed-handoff with a real LLM]
ANTHROPIC_API_KEY=

# OpenAI — alternate agent backend / some eval paths.  [optional]
OPENAI_API_KEY=

# --- Claude on Vertex AI (the [vertex] / [gemini] extras) ------------------
# Used when routing agents through Google Cloud instead of a direct API key.
# Auth is via Application Default Credentials.  [required-for: vertex/gemini extras]
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
ANTHROPIC_VERTEX_PROJECT_ID=

# --- Braintrust eval logging ----------------------------------------------
# Optional experiment tracking for governance benchmarks.  [optional]
BRAINTRUST_API_KEY=
BRAINTRUST_PROJECT=constitutional-swarm

# --- Compliance certificate signing ---------------------------------------
# HMAC secret for signing governance compliance certificates. If unset, the
# certificate path is disabled.  [required-for: compliance-certificate emission]
CONSTITUTIONAL_SWARM_COMPLIANCE_CERTIFICATE_SECRET=

# --- Claude Code config (tooling only) ------------------------------------
# Overrides the Claude Code config dir; not used by the package itself.  [optional]
# CLAUDE_CONFIG_DIR=
